{
  "version": 1,
  "functions": {
    "/_middleware": {
      "runtime": "nodejs",
      "matchers": [
        {
          "regexp": "^(?:\\/(_next\\/data\\/[^/]{1,}))?\\/llms\\.txt(\\.json|\\.rsc|\\.segments\\/.+\\.segment\\.rsc)?[\\/#\\?]?$",
          "originalSource": "/llms.txt"
        }
      ]
    },
    "/api/[...path]": {
      "maxDuration": 60
    },
    "/api/navigation-menu": {},
    "/og-image": {}
  }
}