a:["$","section",null,{"className":"mb-12","children":[["$","h2",null,{"className":"mb-5 text-xl font-semibold text-slate-950 dark:text-white","children":"FAQ"}],["$","div",null,{"className":"space-y-3","children":[["$","details","Can I merge PDFs with different page sizes?",{"className":"border-b border-slate-200 py-4 dark:border-slate-800","children":[["$","summary",null,{"className":"cursor-pointer text-base font-semibold text-slate-950 dark:text-white","children":"Can I merge PDFs with different page sizes?"}],["$","p",null,{"className":"mt-3 leading-7 text-slate-700 dark:text-slate-300","children":"Yes, but the output may mix orientations and dimensions. Review the merged result before sending and standardize source files when presentation matters."}]]}],["$","details","Is splitting a PDF safer than sharing the full file?",{"className":"border-b border-slate-200 py-4 dark:border-slate-800","children":[["$","summary",null,{"className":"cursor-pointer text-base font-semibold text-slate-950 dark:text-white","children":"Is splitting a PDF safer than sharing the full file?"}],["$","p",null,{"className":"mt-3 leading-7 text-slate-700 dark:text-slate-300","children":"Often yes. Extracting only the needed pages reduces file size and lowers the chance of exposing unrelated information."}]]}],["$","details","When should I convert PDF pages to images?",{"className":"border-b border-slate-200 py-4 dark:border-slate-800","children":[["$","summary",null,{"className":"cursor-pointer text-base font-semibold text-slate-950 dark:text-white","children":"When should I convert PDF pages to images?"}],["$","p",null,{"className":"mt-3 leading-7 text-slate-700 dark:text-slate-300","children":"Convert pages to images when you need thumbnails, documentation screenshots, design review previews, or page-level visuals for a website."}]]}],["$","details","Can images be turned into a single PDF?",{"className":"border-b border-slate-200 py-4 dark:border-slate-800","children":[["$","summary",null,{"className":"cursor-pointer text-base font-semibold text-slate-950 dark:text-white","children":"Can images be turned into a single PDF?"}],["$","p",null,{"className":"mt-3 leading-7 text-slate-700 dark:text-slate-300","children":"Yes. Use image-to-PDF when scans, receipts, screenshots, or product images need to be shared as one document."}]]}],["$","details","Do browser PDF tools replace professional PDF editors?",{"className":"border-b border-slate-200 py-4 dark:border-slate-800","children":[["$","summary",null,{"className":"cursor-pointer text-base font-semibold text-slate-950 dark:text-white","children":"Do browser PDF tools replace professional PDF editors?"}],["$","p",null,{"className":"mt-3 leading-7 text-slate-700 dark:text-slate-300","children":"No. Browser tools are best for fast merging, splitting, and conversion. Use a professional editor for redaction, signatures, OCR, forms, and legal production workflows."}]]}]]}]]}]
