26:["$","section",null,{"className":"mb-12","children":[["$","h2",null,{"className":"mb-5 text-xl font-semibold text-slate-950 dark:text-white","children":"FAQ"}],["$","div",null,{"className":"space-y-3","children":[["$","details","What is the best image format for websites?",{"className":"border-b border-slate-200 py-4 dark:border-slate-800","children":[["$","summary",null,{"className":"cursor-pointer text-base font-semibold text-slate-950 dark:text-white","children":"What is the best image format for websites?"}],["$","p",null,{"className":"mt-3 leading-7 text-slate-700 dark:text-slate-300","children":"Use WebP for many web photos and illustrations, SVG for logos and icons, PNG for transparency or crisp screenshots, and JPEG when broad compatibility for photography matters. The best format depends on the content and where it will be displayed."}]]}],["$","details","Should I crop before compressing?",{"className":"border-b border-slate-200 py-4 dark:border-slate-800","children":[["$","summary",null,{"className":"cursor-pointer text-base font-semibold text-slate-950 dark:text-white","children":"Should I crop before compressing?"}],["$","p",null,{"className":"mt-3 leading-7 text-slate-700 dark:text-slate-300","children":"Yes. Cropping and resizing remove unnecessary pixels before compression, which usually produces a smaller and cleaner output than compressing first."}]]}],["$","details","When should I use Base64 images?",{"className":"border-b border-slate-200 py-4 dark:border-slate-800","children":[["$","summary",null,{"className":"cursor-pointer text-base font-semibold text-slate-950 dark:text-white","children":"When should I use Base64 images?"}],["$","p",null,{"className":"mt-3 leading-7 text-slate-700 dark:text-slate-300","children":"Use Base64 only for tiny assets where avoiding an additional request matters more than separate caching. Large images should remain normal files."}]]}],["$","details","Are ToolOrbit image tools local-first?",{"className":"border-b border-slate-200 py-4 dark:border-slate-800","children":[["$","summary",null,{"className":"cursor-pointer text-base font-semibold text-slate-950 dark:text-white","children":"Are ToolOrbit image tools local-first?"}],["$","p",null,{"className":"mt-3 leading-7 text-slate-700 dark:text-slate-300","children":"The core image utilities are designed around browser processing where possible. Users should still verify sensitive workflows with the browser Network tab before processing confidential images."}]]}],["$","details","Can image optimization improve AdSense approval quality?",{"className":"border-b border-slate-200 py-4 dark:border-slate-800","children":[["$","summary",null,{"className":"cursor-pointer text-base font-semibold text-slate-950 dark:text-white","children":"Can image optimization improve AdSense approval quality?"}],["$","p",null,{"className":"mt-3 leading-7 text-slate-700 dark:text-slate-300","children":"It can support quality signals by improving page speed, visual polish, and content usefulness. It does not replace original written content, but it helps pages feel maintained and user-focused."}]]}]]}]]}]
