a:["$","section",null,{"className":"mb-12","children":[["$","h2",null,{"className":"mb-5 text-xl font-semibold text-slate-950 dark:text-white","children":"FAQ"}],["$","div",null,{"className":"space-y-3","children":[["$","details","What is the difference between text cleaning and text polishing?",{"className":"border-b border-slate-200 py-4 dark:border-slate-800","children":[["$","summary",null,{"className":"cursor-pointer text-base font-semibold text-slate-950 dark:text-white","children":"What is the difference between text cleaning and text polishing?"}],["$","p",null,{"className":"mt-3 leading-7 text-slate-700 dark:text-slate-300","children":"Cleaning applies mechanical rules such as removing spaces or blank lines. Polishing changes wording, tone, or structure and should be reviewed before publishing."}]]}],["$","details","Can text tools handle code snippets?",{"className":"border-b border-slate-200 py-4 dark:border-slate-800","children":[["$","summary",null,{"className":"cursor-pointer text-base font-semibold text-slate-950 dark:text-white","children":"Can text tools handle code snippets?"}],["$","p",null,{"className":"mt-3 leading-7 text-slate-700 dark:text-slate-300","children":"Some can. Text diff, regex tester, Unicode converter, and text analyzer are useful for snippets, but destructive cleaning rules should be used carefully on code."}]]}],["$","details","Why use a text diff tool for writing?",{"className":"border-b border-slate-200 py-4 dark:border-slate-800","children":[["$","summary",null,{"className":"cursor-pointer text-base font-semibold text-slate-950 dark:text-white","children":"Why use a text diff tool for writing?"}],["$","p",null,{"className":"mt-3 leading-7 text-slate-700 dark:text-slate-300","children":"Diffs reveal exactly what changed between drafts, which helps editors, translators, and reviewers avoid accidental meaning changes."}]]}],["$","details","Are symbol libraries useful for professional content?",{"className":"border-b border-slate-200 py-4 dark:border-slate-800","children":[["$","summary",null,{"className":"cursor-pointer text-base font-semibold text-slate-950 dark:text-white","children":"Are symbol libraries useful for professional content?"}],["$","p",null,{"className":"mt-3 leading-7 text-slate-700 dark:text-slate-300","children":"Yes, when used sparingly. Symbols can clarify UI labels, compact notes, formulas, and product copy, but overuse can make content harder to read."}]]}],["$","details","Should I paste confidential text into AI tools?",{"className":"border-b border-slate-200 py-4 dark:border-slate-800","children":[["$","summary",null,{"className":"cursor-pointer text-base font-semibold text-slate-950 dark:text-white","children":"Should I paste confidential text into AI tools?"}],["$","p",null,{"className":"mt-3 leading-7 text-slate-700 dark:text-slate-300","children":"Only if your policy allows it. Counting, cleaning, and diffing can often run locally; AI rewriting usually requires a model request and should be treated differently."}]]}]]}]]}]
