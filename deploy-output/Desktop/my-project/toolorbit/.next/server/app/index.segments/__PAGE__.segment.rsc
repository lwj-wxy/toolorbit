hnical writing for practical workflows"],"contactPoint":{"@type":"ContactPoint","email":"luowj1998@outlook.com","contactType":"customer support","availableLanguage":["English","Chinese"]},"publishingPrinciples":"https://toolorbit.site/about"},"about":"Most ToolOrbit utilities run directly in the browser so files, text, and developer data stay on the user device unless an AI-powered feature explicitly needs a model request."},{"@context":"https://schema.org","@type":"ItemList","itemListElement":[{"@type":"ListItem","position":1,"url":"https://toolorbit.site/tools/ai/youtube-generator","name":"YouTube Title & Description Generator | Video SEO Copy","description":"Enter a video topic and target audience to generate clickable YouTube titles, SEO-friendly descriptions, tags, and thumbnail ideas for faster publishing."},{"@type":"ListItem","position":2,"url":"https://toolorbit.site/tools/ai/prompt-generator","name":"AI Prompt Generator | Midjourney & Stable Diffusion Prompts","description":"Turn a simple image idea into a richer Midjourney, Stable Diffusion, or image-model prompt with visual details, composition cues, lighting, and style direction."},{"@type":"ListItem","position":3,"url":"https://toolorbit.site/tools/ai/weekly-report","name":"AI Weekly Report Generator | Work Summary Writer","description":"Convert scattered weekly tasks, next-week plans, and blockers into a polished work report that is clear, structured, and ready to share."},{"@type":"ListItem","position":4,"url":"https://toolorbit.site/tools/ai/code-reviewer","name":"AI Code Reviewer | Bug & Refactor Feedback","description":"Paste a code snippet and get AI-assisted review feedback for bugs, security risks, readability issues, and refactoring opportunities."},{"@type":"ListItem","position":5,"url":"https://toolorbit.site/tools/ai/video-script","name":"AI Video Script Generator | TikTok & Shorts Creator","description":"Generate complete short video shooting scripts, including visual descriptions, voiceovers, timelines, and BGM suggestions, to help content creators work efficiently."},{"@type":"ListItem","position":6,"url":"https://toolorbit.site/tools/ai/meeting-minutes","name":"AI Meeting Minutes Generator | Speech to Text Summary","description":"Paste your messy meeting transcripts or notes, and let AI automatically organize core conclusions and action items to boost workplace efficiency."},{"@type":"ListItem","position":7,"url":"https://toolorbit.site/tools/ai/excel-formula","name":"AI Excel Formula Generator | Google Sheets Assistant","description":"Stop struggling with complex Excel and Google Sheets formulas. Just describe your problem and our AI will generate the formula instantly."},{"@type":"ListItem","position":8,"url":"https://toolorbit.site/tools/ai/logo-generator","name":"AI Logo & Avatar Generator","description":"Use AI to design professional logos, avatars, and website icons instantly."},{"@type":"ListItem","position":9,"url":"https://toolorbit.site/tools/ai/image-generator","name":"AI Image Generator | Text to Image","description":"Use AI to generate stunning images from text prompts. Support for 16:9, 1:1, 9:16 aspect ratios and various art styles like photorealistic, anime, and cyberpunk."},{"@type":"ListItem","position":10,"url":"https://toolorbit.site/tools/ai/svg-generator","name":"AI SVG Generator | Vector Image Creator","description":"Use AI to generate scalable vector graphics (SVG) from text parameters and style preferences. Perfect for web design and frontend projects."},{"@type":"ListItem","position":11,"url":"https://toolorbit.site/tools/ai/xiaohongshu","name":"Xiaohongshu (RED) AI Copywriter | Viral Post Generator","description":"Automatically generate viral-ready Xiaohongshu (RED) copy with emojis and hashtags using AI. Supports various popular tones like product review and tutorials."},{"@type":"ListItem","position":12,"url":"https://toolorbit.site/tools/ai/text-polisher","name":"Free AI Text Polisher & Rewriter Tool: Instantly Improve Your Writing","description":"Utilize advanced large language models to eliminate grammar issues, improve sentence flow, and seamlessly switch tones with a single click. Ideal for professional emails, academic papers, and social media posts."}]}]0:{"rsc":["$","$1","c",{"children":[[["$","template",null,{"id":"structured-data-home","dangerouslySetInnerHTML":{"__html":"$2"}}],"$L3"],["$L4","$L5"],"$L6"]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"bYYi-ZPGnf7tmCL1WLFhj"}
