{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/best-json-formatters/layout,_N_T_/best-json-formatters/page,_N_T_/best-json-formatters"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/best-json-formatters/__PAGE__",
    "/best-json-formatters",
    "/_index",
    "/_head"
  ]
}