1e:[["$","title","0",{"children":"AI 找到 23000 个漏洞之后：当代码审计快到人类跟不上的那一天 | ToolOrbit"}],["$","meta","1",{"name":"description","content":"Claude Mythos 扫描 1000+ 开源项目找出 23019 个漏洞，90.6% 为真实漏洞，但修复率不到 15%。AI 驱动的代码审计正在颠覆安全行业的底层逻辑。 查看实用示例和相关 ToolOrbit 浏览器工具，帮助更快完成日常任务。"}],["$","meta","2",{"name":"application-name","content":"ToolOrbit"}],["$","link","3",{"rel":"author","href":"https://toolorbit.site/authors/luo-wj"}],["$","meta","4",{"name":"author","content":"Luo WJ"}],["$","link","5",{"rel":"manifest","href":"/manifest.json","crossOrigin":"$undefined"}],["$","meta","6",{"name":"creator","content":"ToolOrbit"}],["$","meta","7",{"name":"publisher","content":"ToolOrbit"}],["$","meta","8",{"name":"robots","content":"index, follow"}],["$","meta","9",{"name":"googlebot","content":"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1"}],["$","meta","10",{"name":"google-adsense-account","content":"ca-pub-5608961818345363"}],["$","link","11",{"rel":"canonical","href":"https://toolorbit.site/zh-CN/blog/ai-security-code-audit"}],["$","link","12",{"rel":"alternate","hrefLang":"en","href":"https://toolorbit.site/blog/ai-security-code-audit"}],["$","link","13",{"rel":"alternate","hrefLang":"zh-CN","href":"https://toolorbit.site/zh-CN/blog/ai-security-code-audit"}],["$","link","14",{"rel":"alternate","hrefLang":"x-default","href":"https://toolorbit.site/blog/ai-security-code-audit"}],["$","meta","15",{"property":"og:title","content":"AI 找到 23000 个漏洞之后：当代码审计快到人类跟不上的那一天 | ToolOrbit"}],["$","meta","16",{"property":"og:description","content":"Claude Mythos 扫描 1000+ 开源项目找出 23019 个漏洞，90.6% 为真实漏洞，但修复率不到 15%。AI 驱动的代码审计正在颠覆安全行业的底层逻辑。 查看实用示例和相关 ToolOrbit 浏览器工具，帮助更快完成日常任务。"}],["$","meta","17",{"property":"og:url","content":"https://toolorbit.site/zh-CN/blog/ai-security-code-audit"}],["$","meta","18",{"property":"og:site_name","content":"ToolOrbit"}],["$","meta","19",{"property":"og:locale","content":"zh_CN"}],["$","meta","20",{"property":"og:image","content":"https://toolorbit.site/og-image?title=AI+%E6%89%BE%E5%88%B0+23000+%E4%B8%AA%E6%BC%8F%E6%B4%9E%E4%B9%8B%E5%90%8E%EF%BC%9A%E5%BD%93%E4%BB%A3%E7%A0%81%E5%AE%A1%E8%AE%A1%E5%BF%AB%E5%88%B0%E4%BA%BA%E7%B1%BB%E8%B7%9F%E4%B8%8D%E4%B8%8A%E7%9A%84%E9%82%A3%E4%B8%80%E5%A4%A9&description=Claude+Mythos+%E6%89%AB%E6%8F%8F+1000%2B+%E5%BC%80%E6%BA%90%E9%A1%B9%E7%9B%AE%E6%89%BE%E5%87%BA+23019+%E4%B8%AA%E6%BC%8F%E6%B4%9E%EF%BC%8C90.6%25+%E4%B8%BA%E7%9C%9F%E5%AE%9E%E6%BC%8F%E6%B4%9E%EF%BC%8C%E4%BD%86%E4%BF%AE%E5%A4%8D%E7%8E%87%E4%B8%8D%E5%88%B0+15%25%E3%80%82AI+%E9%A9%B1%E5%8A%A8%E7%9A%84%E4%BB%A3%E7%A0%81%E5%AE%A1%E8%AE%A1%E6%AD%A3%E5%9C%A8%E9%A2%A0%E8%A6%86%E5%AE%89%E5%85%A8%E8%A1%8C%E4%B8%9A%E7%9A%84%E5%BA%95%E5%B1%82%E9%80%BB%E8%BE%91%E3%80%82+%E6%9F%A5%E7%9C%8B%E5%AE%9E%E7%94%A8%E7%A4%BA%E4%BE%8B%E5%92%8C%E7%9B%B8%E5%85%B3+ToolOrbit+%E6%B5%8F%E8%A7%88%E5%99%A8%E5%B7%A5%E5%85%B7%EF%BC%8C%E5%B8%AE%E5%8A%A9%E6%9B%B4%E5%BF%AB%E5%AE%8C%E6%88%90%E6%97%A5%E5%B8%B8%E4%BB%BB%E5%8A%A1%E3%80%82"}],["$","meta","21",{"property":"og:image:width","content":"1200"}],["$","meta","22",{"property":"og:image:height","content":"630"}],["$","meta","23",{"property":"og:image:alt","content":"AI 找到 23000 个漏洞之后：当代码审计快到人类跟不上的那一天"}],["$","meta","24",{"property":"og:locale:alternate","content":"en_US"}],["$","meta","25",{"property":"og:type","content":"article"}],["$","meta","26",{"property":"article:published_time","content":"2026-05-28"}],["$","meta","27",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","28",{"name":"twitter:title","content":"AI 找到 23000 个漏洞之后：当代码审计快到人类跟不上的那一天 | ToolOrbit"}],["$","meta","29",{"name":"twitter:description","content":"Claude Mythos 扫描 1000+ 开源项目找出 23019 个漏洞，90.6% 为真实漏洞，但修复率不到 15%。AI 驱动的代码审计正在颠覆安全行业的底层逻辑。 查看实用示例和相关 ToolOrbit 浏览器工具，帮助更快完成日常任务。"}],["$","meta","30",{"name":"twitter:image","content":"https://toolorbit.site/og-image?title=AI+%E6%89%BE%E5%88%B0+23000+%E4%B8%AA%E6%BC%8F%E6%B4%9E%E4%B9%8B%E5%90%8E%EF%BC%9A%E5%BD%93%E4%BB%A3%E7%A0%81%E5%AE%A1%E8%AE%A1%E5%BF%AB%E5%88