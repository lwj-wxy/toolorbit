k:text-blue-300","children":"AI"}],["$","h3",null,{"className":"mt-2 text-lg font-semibold text-slate-950 group-hover:text-blue-700 dark:text-white dark:group-hover:text-blue-300","children":"提升你的写作：AI 文本润色的力量"}],["$","p",null,{"className":"mt-2 line-clamp-2 text-sm leading-6 text-slate-600 dark:text-slate-300","children":"探索人工智能驱动的文本润色工具如何将您的草稿转化为在各种基调和风格下都显得专业且流畅的内容。"}],["$","span",null,{"className":"mt-4 inline-flex items-center gap-2 text-sm font-semibold text-blue-700 dark:text-blue-300","children":["阅读指南"," ",["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right h-4 w-4","aria-hidden":"true","children":[["$","path","1ays0h",{"d":"M5 12h14"}],["$","path","xquz4c",{"d":"m12 5 7 7-7 7"}],"$undefined"]}]]}]]}],["$","$L22","ai-translator-future",{"href":"/blog/ai-translator-future","className":"group rounded-lg border border-slate-200 bg-white p-5 shadow-sm transition-colors hover:border-blue-300 hover:bg-blue-50/20 dark:border-slate-800 dark:bg-slate-900 dark:hover:border-blue-700 dark:hover:bg-blue-950/20","children":[["$","span",null,{"className":"text-xs font-semibold uppercase tracking-wide text-blue-700 dark:text-blue-300","children":"AI"}],["$","h3",null,{"className":"mt-2 text-lg font-semibold text-slate-950 group-hover:text-blue-700 dark:text-white dark:group-hover:text-blue-300","children":"超越逐字翻译：上下文 AI 翻译的未来"}],["$","p",null,{"className":"mt-2 line-clamp-2 text-sm leading-6 text-slate-600 dark:text-slate-300","children":"传统的翻译器常常无法捕捉细微差别。了解上下文 AI 翻译如何以接近母语的准确性打破语言障碍。"}],["$","span",null,{"className":"mt-4 inline-flex items-center gap-2 text-sm font-semibold text-blue-700 dark:text-blue-300","children":["阅读指南"," ",["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke"