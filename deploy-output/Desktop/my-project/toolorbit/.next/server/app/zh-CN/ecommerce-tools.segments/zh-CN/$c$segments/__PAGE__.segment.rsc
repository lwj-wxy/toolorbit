700 dark:text-blue-300","children":"商业运营"}],["$","h3",null,{"className":"mt-2 text-lg font-semibold text-slate-950 group-hover:text-blue-700 dark:text-white dark:group-hover:text-blue-300","children":"Etsy 定价策略：如何为利润（而非收入）定价"}],["$","p",null,{"className":"mt-2 line-clamp-2 text-sm leading-6 text-slate-600 dark:text-slate-300","children":"学会系统化的 Etsy 定价方法——从成本出发、计入每一项费用、设定目标利润、反推出理想售价。告别凭感觉定价。"}],["$","span",null,{"className":"mt-4 inline-flex items-center gap-2 text-sm font-semibold text-blue-700 dark:text-blue-300","children":["阅读指南"," ",["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right h-4 w-4","aria-hidden":"true","children":[["$","path","1ays0h",{"d":"M5 12h14"}],["$","path","xquz4c",{"d":"m12 5 7 7-7 7"}],"$undefined"]}]]}]]}],["$","$L1c","etsy-offsite-ads-explained",{"href":"/blog/etsy-offsite-ads-explained","className":"group rounded-lg border border-slate-200 bg-white p-5 shadow-sm transition-colors hover:border-blue-300 hover:bg-blue-50/20 dark:border-slate-800 dark:bg-slate-900 dark:hover:border-blue-700 dark:hover:bg-blue-950/20","children":[["$","span",null,{"className":"text-xs font-semibold uppercase tracking-wide text-blue-700 dark:text-blue-300","children":"商业运营"}],["$","h3",null,{"className":"mt-2 text-lg font-semibold text-slate-950 group-hover:text-blue-700 dark:text-white dark:group-hover:text-blue-300","children":"Etsy 站外广告详解：你未必能退出的广告费计划"}],["$","p",null,{"className":"mt-2 line-clamp-2 text-sm leading-6 text-slate-600 dark:text-slate-300","children":"Etsy 站外广告按归因订单的 12% 或 15% 收取。了解两档费率、$100 单笔上限、有效费率计算，以及如何将广告成本纳入定价体系。"}],["$","span",null,{"className":"mt-4 inline-flex items-center gap-2 text-sm font-semibold text-blue-700 dark:text-blue-300","children":["阅读指南"," ","$L29"]}]]}],"$L2a","$L2b"]}]]}]
11:["$","section",null,{"className":"mb-12","children":[["$","h2",null,{"className":"mb-5 text-xl font-semibold text-slate-950 dark:text-white","children":"常见问题"}],["$","div",null,{"className":"space-y-3","children":[["$","details","Etsy 从一笔销售中抽取多少费用？",{"className":"border-b border-slate-200 py-4 dark:border-slate-800","children":[["$","summary",null,{"className":"cursor-pointer text-base font-semibold text-slate-950 dark:text-white","children":"Etsy 从一笔销售中抽取多少费用？"}],["$","p",null,{"className":"mt-3 leading-7 text-slate-700 dark:text-slate-300","children":"Etsy 核心费用总计约为订单金额的 10%：$0.20 上架费 + 6.5% 交易费 + 3% + $0.25 支付处理费。额外可选费用包括站外广告费（归因订单的 12% 或 15%）、监管运营费（根据卖家所在地 0.35%–1.1%）和货币转换费（当商品币种与收款币种不同时收取 2.5%）。本页面的 Etsy 利润计算器可为任何订单场景显示精确的费用明细。"}]]}],["$","details","我可以退出 Etsy 站外广告吗？",{"className":"border-b border-slate-200 py-4 dark:border-slate-800","children":[["$","summary",null,{"className":"cursor-pointer text-base font-semibold text-slate-950 dark:text-white","children":"我可以退出 Etsy 站外广告吗？"}],["$","p",null,{"className":"mt-3 leading-7 text-slate-700 dark:text-slate-300","children":"如果你的店铺在过去 12 个月内的销售额低于 $10,000，你可以选择退出。一旦超过该门槛，将以 12% 的费率强制参与。Etsy 站外广告费计算器可帮助你在达到门槛前后建模费用影响。"}]]}],["$","details","我应该如何为 Etsy 产品定价？",{"className":"border-b border-slate-200 py-4 dark:border-slate-800","children":[["$","summary",null,{"className":"cursor-pointer text-base font-semibold text-slate-950 dark:text-white","children":"我应该如何为 Etsy 产品定价？"}],["$","p",null,{"className":"mt-3 leading-7 text-slate-700 dark:text-slate-300","children":"从每件商品的总成本出发（材料、人工、包装、实际运费），加上你的目标利润，计入所有 Etsy 费用（包括任何可选的站外广告费或监管费），然后反推出商品标价。Etsy 目标售价计算器自动化了这个完整流程，并排对比包邮和买家付运费两种场景。"}]]}],["$","details","这些计算器与我的 Etsy 账单相比有多准确？",{"className":"border-b border-slate-200 py-4 dark:border-slate-800","children":[["$","summary",null,{"className":"cursor-pointer text-base font-semibold text-slate-950 dark:text-white","children":"这些计算器与我的 Etsy 账单相比有多准确？"}],["$","p",null,{"className":"mt-3 leading-7 text-slate-700 dark:text-slate-300","children":"计算器使用公开记录的美国 Etsy 费率。它们对估算和定价决策是准确的。但是，Etsy 可能会更新费率，且部分费用因地区而异。务必以官方 Etsy 收款账户账单为准进行会计和税务用途。计算器专为运营性定价决策设计，而非记账的替代品。"}]]}],["$","details","使用这些工具需要创建账号吗？",{"className":"border-b border-slate-200 py-4 dark:border-slate-800","children":[["$","summary",null,{"className":"cursor-pointer text-base font-semibold text-slate-950 dark:text-white","children":"使用这些工具需要创建账号吗？"}],["$","p",null,{"className":"mt-3 leading-7 text-slate-700 dark:text-slate-300","children":"不需要。所有 ToolOrbit 电商计算器均免费、无需注册、无需账号、无需安装。计算在你的浏览器中运行，你的财务数据永远不会离开你的设备。打开工具，输入数字，即刻获取结果。"}]]}],["$","details","我应该选择在 Etsy 上销售还是在自己的网站上销售？",{"className":"border-b border-slate-200 py-4 dark:border-slate-800","children":[["$","summary",null,{"className":"cursor-pointer text-base font-semibold text-slate-950 dark:text-white","children":"我应该选择在 Etsy 上销售还是在自己的网站上销售？"}],["$","p",null,{"className":"mt-3 leading-7 text-slate-700 dark:text-slate-300","children":"这取决于你的销售量和利润率。Etsy 提供了接触数百万活跃买家的渠道，但收取约 10–20% 的综合费用。在自己的网站上通过 Stripe 销售，处理费约 3%，但需要自行获取流量。同时使用 Etsy 利润计算器和 Stripe 手续费计算器进行双侧对比。许多成功的卖家从 Etsy 开始积累客户，逐步建立独立站服务复购客户。"}]]}]]}]]}]
12:["$","footer",null,{"className":"border-t border-slate-200 pt-5 text-sm leading-6 text-slate-600 dark:border-slate-800 dark:text-slate-300","children":[["$","p",null,{"className":"flex items-start gap-2","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle-check mt-0.5 h-4 w-4 shrink-0 text-blue-600","aria-hidden":"true","children":[["$","circle","1mglay",{"cx":"12","cy":"12","r":"10"}],["$","path","dzmm74",{"d":"m9 12 2 2 4-4"}],"$undefined"]}],"由 ToolOrbit 编辑团队维护。本页面链接到实用工具和配套指南，帮助读者验证具体工作流，而不是依赖笼统说法。"]}],["$","$L1c",null,{"href":"/authors/toolorbit-editorial-team","className":"mt-3 inline-flex items-center gap-2 font-semibold text-blue-700 dark:text-blue-300","children":["编辑团队资料"," ",["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link h-4 w-4","aria-hidden":"true","children":[["$","path","1q9fwt",{"d":"M15 3h6v6"}],["$","path","gplh6r",{"d":"M10 14 21 3"}],["$","path","a6xqqp",{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"}],"$undefined"]}]]}]]}]
