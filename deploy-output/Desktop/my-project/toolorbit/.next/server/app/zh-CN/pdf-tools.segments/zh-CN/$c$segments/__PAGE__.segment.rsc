18:["$","section","Best practices for private PDF handling",{"className":"mb-10","children":[["$","h2",null,{"children":"Best practices for private PDF handling"}],[["$","p","Treat PDFs as sensitive by default. They may contain hidden metadata, signatures, personal information, or business context. Prefer local-first browser tools when possible and avoid uploading confidential documents to unknown services.",{"children":[["$","$1","0",{"children":"Treat PDFs as sensitive by default. They may contain hidden metadata, signatures, personal information, or business context. Prefer local-first browser tools when possible and avoid uploading confidential documents to unknown services."}]]}],["$","p","Verify outputs before deleting originals. PDF transformations can change page dimensions, image quality, bookmarks, or embedded fonts. A short review step prevents accidental data loss and embarrassing resend requests.",{"children":[["$","$1","0",{"children":"Verify outputs before deleting originals. PDF transformations can change page dimensions, image quality, bookmarks, or embedded fonts. A short review step prevents accidental data loss and embarrassing resend requests."}]]}]]]}]
