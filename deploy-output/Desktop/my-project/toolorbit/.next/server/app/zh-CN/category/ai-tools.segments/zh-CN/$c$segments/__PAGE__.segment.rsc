perations tools","technical writing for practical workflows"],"contactPoint":{"@type":"ContactPoint","email":"luowj1998@outlook.com","contactType":"customer support","availableLanguage":["English","Chinese"]},"publishingPrinciples":"https://toolorbit.site/about"}},{"@context":"https://schema.org","@type":"ItemList","itemListElement":[{"@type":"ListItem","position":1,"url":"https://toolorbit.site/zh-CN/tools/ai/youtube-generator","name":"YouTube 标题简介生成器 | 视频 SEO 文案","description":"输入视频主题和目标观众，即可生成高点击率标题、SEO 优化简介、热门标签和封面创意，帮助 YouTube 内容更容易被搜索和点击。"},{"@type":"ListItem","position":2,"url":"https://toolorbit.site/zh-CN/tools/ai/prompt-generator","name":"AI 绘画提示词生成器 | Midjourney/SD Prompt","description":"输入简单画面想法，即可生成包含主体、构图、光线、风格和氛围细节的高质量绘画提示词，适用于 Midjourney、Stable Diffusion 等图像模型。"},{"@type":"ListItem","position":3,"url":"https://toolorbit.site/zh-CN/tools/ai/weekly-report","name":"AI 周报生成器 | 工作总结自动生成","description":"将本周完成事项、下周计划和风险问题整理成结构清晰、语气专业的工作周报，适合团队汇报、项目同步和个人复盘。"},{"@type":"ListItem","position":4,"url":"https://toolorbit.site/zh-CN/tools/ai/code-reviewer","name":"AI 代码审查 | Bug 检查与重构建议","description":"粘贴代码片段，即可获得面向 Bug、边界条件、安全隐患、可读性和重构方向的 AI 辅助审查反馈。"},{"@type":"ListItem","position":5,"url":"https://toolorbit.site/zh-CN/tools/ai/video-script","name":"短视频脚本生成器 | 抖音/TikTok文案","description":"输入主题即可快速生成包含画面分镜头、旁白、时间轴和BGM建议的完整短视频拍摄脚本，助力自媒体创作者提效。"},{"@type":"ListItem","position":6,"url":"https://toolorbit.site/zh-CN/tools/ai/meeting-minutes","name":"AI 会议纪要生成器 | 录音转写总结","description":"将杂乱的会议语音转译文本或速记粘贴进来，AI 为您自动梳理出核心结论与待办事项，提升职场办公效率。"},{"@type":"ListItem","position":7,"url":"https://toolorbit.site/zh-CN/tools/ai/excel-formula","name":"AI Excel 公式生成器 | 办公效率神器","description":"无需精通Excel函数，只需输入你的计算需求，AI立刻为你写出准确的Excel或Google Sheets公式及详细解释。"},{"@type":"ListItem","position":8,"url":"https://toolorbit.site/zh-CN/tools/ai/regex","name":"AI 正则表达式生成器 | RegEx 编写助手","description":"开发人员必备的 AI 正则提取与匹配工具。用大白话描述规则，即可生成 JS/Python/Go 等语言的准确正则表达式。"},{"@type":"ListItem","position":9,"url":"https://toolorbit.site/zh-CN/tools/ai/logo-generator","name":"AI Logo 生成器 | AI 头像制作","description":"使用 AI 快速生成专业的品牌 Logo、应用图标和个性头像。"},{"@type":"ListItem","position":10,"url":"https://toolorbit.site/zh-CN/tools/ai/image-generator","name":"AI 绘画 | 免费 AI 图像生成器","description":"输入文字描述，AI 立刻作画。提供真实感、动漫、赛博朋克等多种绘画风格，并支持横屏竖屏切换，完全免费、快速的 AI 图像生成工具。"},{"@type":"ListItem","position":11,"url":"https://toolorbit.site/zh-CN/tools/ai/svg-generator","name":"AI SVG 矢量图生成器 | 在线矢量插画","description":"利用 AI 技术自动生成精美、可无限放大的 SVG 矢量图形代码，支持扁平化、线条等多种风格，让前端设计更轻松。"},{"@type":"ListItem","position":12,"url":"https://toolorbit.site/zh-CN/tools/ai/xiaohongshu","name":"小红书文案生存器 | AI 种草文案","description":"利用 AI 自动生成自带网感、包含 Emoji 和话题标签的小红书爆款文案。支持种草测评、干货教程等多种热门风格。"},{"@type":"ListItem","position":13,"url":"https://toolorbit.site/zh-CN/tools/ai/text-polisher","name":"AI 智能修音润色：极速提升文案流畅度与专业感","description":"利用先进的大语言模型，只需点击一次，即可消除语法错误、改善行文自然度并无缝切换说话语气。适合职场邮件、学术报告或社交媒体配文的专业重写工具。"},{"@type":"ListItem","position":14,"url":"https://toolorbit.site/zh-CN/tools/ai/translator","name":"新一代 AI 翻译引擎：拒绝机器味，还原地道母语感","description":"比 Google Translate 更懂您。通过理解完整的上下文语境来重构句子，不仅实现无缝跨界语言转换，还能自定义译文的语气与学术专业度。"},{"@type":"ListItem","position":15,"url":"https://toolorbit.site/zh-CN/tools/ai/listing-generator","name":"电商 Listing 商品文案生成器","description":"输入产品名称和核心卖点，为 Etsy、Amazon、Shopify 或 eBay 生成商品标题、描述、标签和社媒文案草稿。"},{"@type":"ListItem","position":16,"url":"https://toolorbit.site/zh-CN/tools/ai/keyword-analyzer","name":"电商长尾关键词分析器","description":"从一个种子产品词出发，探索长尾关键词、竞争信号和商品定位角度，用于 marketplace 选词和内容规划。"},{"@type":"ListItem","position":17,"url":"https://toolorbit.site/zh-CN/tools/ai/competitor-tracker","name":"商品竞品分析与定位工具","description":"输入你的产品和竞品描述，比较定位差异、卖点强弱和改进机会，辅助商品文案、图片和策略调整。"},{"@type":"ListItem","position":18,"url":"https://toolorbit.site/zh-CN/tools/ai/market-insights","name":"电商市场趋势洞察工具","description":"为 Etsy、Amazon、TikTok Shop 或 eBay 生成平台化市场洞察草稿，探索类目趋势、需求信号和产品机会。"}]}]0:{"rsc":["$","$1","c",{"children":[["$","$L2",null,{"langua