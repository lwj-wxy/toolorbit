1e:[["$","title","0",{"children":"AI 会议纪要：再也不会错过任何关键细节 | ToolOrbit"}],["$","meta","1",{"name":"description","content":"会议消耗了每周 35% 的工作时间。看看 AI 纪要工具如何将对话综合成带有行动项和责任人归属的结构化摘要。 查看实用示例和相关 ToolOrbit 浏览器工具，帮助更快完成日常任务。"}],["$","meta","2",{"name":"application-name","content":"ToolOrbit"}],["$","link","3",{"rel":"author","href":"https://toolorbit.site/authors/luo-wj"}],["$","meta","4",{"name":"author","content":"Luo WJ"}],["$","link","5",{"rel":"manifest","href":"/manifest.json","crossOrigin":"$undefined"}],["$","meta","6",{"name":"creator","content":"ToolOrbit"}],["$","meta","7",{"name":"publisher","content":"ToolOrbit"}],["$","meta","8",{"name":"robots","content":"index, follow"}],["$","meta","9",{"name":"googlebot","content":"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1"}],["$","meta","10",{"name":"google-adsense-account","content":"ca-pub-5608961818345363"}],["$","link","11",{"rel":"canonical","href":"https://toolorbit.site/zh-CN/blog/ai-meeting-minutes-guide"}],["$","link","12",{"rel":"alternate","hrefLang":"en","href":"https://toolorbit.site/blog/ai-meeting-minutes-guide"}],["$","link","13",{"rel":"alternate","hrefLang":"zh-CN","href":"https://toolorbit.site/zh-CN/blog/ai-meeting-minutes-guide"}],["$","link","14",{"rel":"alternate","hrefLang":"x-default","href":"https://toolorbit.site/blog/ai-meeting-minutes-guide"}],["$","meta","15",{"property":"og:title","content":"AI 会议纪要：再也不会错过任何关键细节 | ToolOrbit"}],["$","meta","16",{"property":"og:description","content":"会议消耗了每周 35% 的工作时间。看看 AI 纪要工具如何将对话综合成带有行动项和责任人归属的结构化摘要。 查看实用示例和相关 ToolOrbit 浏览器工具，帮助更快完成日常任务。"}],["$","meta","17",{"property":"og:url","content":"https://toolorbit.site/zh-CN/blog/ai-meeting-minutes-guide"}],["$","meta","18",{"property":"og:site_name","content":"ToolOrbit"}],["$","meta","19",{"property":"og:locale","content":"zh_CN"}],["$","meta","20",{"property":"og:image","content":"https://toolorbit.site/og-image?title=AI+%E4%BC%9A%E8%AE%AE%E7%BA%AA%E8%A6%81%EF%BC%9A%E5%86%8D%E4%B9